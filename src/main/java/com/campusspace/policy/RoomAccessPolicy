package com.campusspace.policy;

import com.campusspace.model.Room;
import org.springframework.stereotype.Component;

import java.util.Locale;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

@Component
public class RoomAccessPolicy {

    private static final Pattern NUMBER_PATTERN =
            Pattern.compile("^(\\d{3})[A-Z]?$");

    public boolean isBookable(Room room) {

        if (room == null) {
            return false;
        }

        if (!Boolean.TRUE.equals(room.getBookable())) {
            return false;
        }

        if (room.getFloor() == null || room.getFloor() != 2) {
            return false;
        }

        if (room.getBlock() == null ||
                room.getRoomNumber() == null) {
            return false;
        }

        String block = room.getBlock()
                .trim().toUpperCase(Locale.ROOT);

        String numberText = room.getRoomNumber()
                .trim().toUpperCase(Locale.ROOT);

        Matcher matcher = NUMBER_PATTERN.matcher(numberText);

        if (!matcher.matches()) {
            return false;
        }

        int number = Integer.parseInt(matcher.group(1));

        if (block.equals("C1.1")
                && number >= 262 && number <= 273) {
            return false;
        }

        if (block.equals("C1.3")
                && number >= 249 && number <= 262) {
            return false;
        }

        return true;
    }
}
